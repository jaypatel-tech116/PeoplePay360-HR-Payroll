PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL / Supabase Database Connection URI
DATABASE_URL=postgresql://postgres:your_postgres_password@db.your-supabase-project.supabase.co:5432/postgres

# JWT Secret & Expiry
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cloudinary Credentials (for avatar cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
